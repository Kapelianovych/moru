{
  "type": "module",
  "workspaces": [
    "./ui",
    "./core",
    "./store",
    "./server",
    "./website",
    "./controller",
    "./vite-plugin"
  ],
  "scripts": {
    "format": "prettier . --write",
    "test:core": "node --test \"./core/tests/**/*.test.js\"",
    "test:store": "node --test \"./store/tests/**/*.test.js\"",
    "test:controller": "vitest run --config ./vitest.config.controller.js",
    "start:website": "npm start -w website",
    "build:website": "npm run build -w website"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
